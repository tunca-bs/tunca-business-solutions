.section-head h2{font-size:40px;line-height:1.1;margin:10px 0 14px}
.section-head p{color:var(--muted);font-size:18px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:28px}
.card h3{margin:8px 0 10px;font-size:21px}
.card p{color:var(--muted);margin:0}
.icon{width:44px;height:44px;border-radius:10px;display:grid;place-items:center;border:1px solid rgba(82,190,255,.35);color:#5ec5ff;font-weight:900}
.dark-alt{background:#091624}
.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.step{padding:24px;border-top:2px solid var(--blue);background:rgba(255,255,255,.035);border-radius:0 0 12px 12px}
.step b{font-size:13px;color:#58c0ff}
.step h3{margin:10px 0 6px;font-size:18px}
.step p{color:var(--muted);font-size:14px}
.band{background:linear-gradient(100deg,#0b2037,#0b1728);border-block:1px solid var(--line)}
.contact{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px}
.contact-box{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:30px}
.contact-item{padding:14px 0;border-bottom:1px solid var(--line)}
.contact-item:last-child{border-bottom:0}
.contact-item small{display:block;color:#8192a7}
.contact-item a{color:#63c4ff}
form{display:grid;grid-template-columns:1fr 1fr;gap:14px}
form .full{grid-column:1/-1}
label{font-size:13px;color:#b8c6d5}
input,textarea,select{width:100%;margin-top:7px;padding:13px 14px;background:#07111f;border:1px solid rgba(255,255,255,.14);border-radius:8px;color:#fff;font:inherit}
textarea{min-height:140px;resize:vertical}
footer{border-top:1px solid var(--line);padding:35px 0;color:#8291a4}
.footer-grid{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.footer-links{display:flex;gap:18px;flex-wrap:wrap}
.page{padding:75px 0}
.page h1{font-size:52px}
.legal{max-width:850px}
.legal h2{margin-top:36px}
.legal p,.legal li{color:#b7c4d3}
.mobile-menu{display:none}
@media(max-width:900px){
 .nav-links{display:none}.mobile-menu{display:block}.hero-grid,.contact{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
 .nav-inner{height:68px}.hero{padding:75px 0 60px}.hero-card{display:none}section{padding:65px 0}.grid,.steps{grid-template-columns:1fr}form{grid-template-columns:1fr}form .full{grid-column:auto}.page h1{font-size:40px}
}

